model ProfileImage {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceType  ProfileImageSourceType
  url         String?
  storageKey  String?
  provider    String?
  mimeType    String?
  sizeBytes   Int?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  userProfile UserProfile?
}
